	<macro name="SIGN">
		<eqn>output</eqn>
		<parm>input</parm>
		<variables>
			<aux name="input" access="input">
				<eqn>0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="output" access="output">
				<eqn>IF input &lt; 0 THEN -1
ELSE 1</eqn>
				<units>dmnl</units>
			</aux>
		</variables>
		<view isee:show_pages="false" background="white" page_width="768" page_height="588" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
			<style>
				<graph>
					<isee:series_styles>
						<isee:series_style color="blue" thickness="1"/>
						<isee:series_style color="red" thickness="1"/>
						<isee:series_style color="fuchsia" thickness="1"/>
						<isee:series_style color="#008F44" thickness="1"/>
						<isee:series_style color="#FF7F00" thickness="1"/>
						<isee:series_style color="#7F00FF" thickness="1"/>
						<isee:series_style color="#0CA0FF" thickness="1"/>
						<isee:series_style color="lime" thickness="1"/>
						<isee:series_style color="#FF007F" thickness="1"/>
						<isee:series_style color="aqua" thickness="1"/>
						<isee:series_style color="#F586FF" thickness="1"/>
						<isee:series_style color="black" thickness="1"/>
						<isee:series_style color="#C8C8C8" thickness="1"/>
					</isee:series_styles>
				</graph>
			</style>
			<aux font_weight="bold" x="306" y="123" name="input"/>
			<aux x="310" y="229" name="output"/>
			<connector uid="1" angle="259.046">
				<from>input</from>
				<to>output</to>
			</connector>
		</view>
	</macro>
	<macro name="SIXPARM">
		<eqn>Output</eqn>
		<parm>first level</parm>
		<parm>start year first level</parm>
		<parm>time to implement first level</parm>
		<parm>second level</parm>
		<parm>time to start second level</parm>
		<parm>time to implement second level</parm>
		<variables>
			<aux name="Output" access="output">
				<doc>${Policy}
</doc>
				<eqn>RAMP(first_level/time_to_implement_first_level, start_year_first_level, start_year_first_level+time_to_implement_first_level)
+
RAMP((second_level -first_level)/time_to_implement_second_level, start_year_first_level  + time_to_start_second_level, start_year_first_level + time_to_start_second_level + time_to_implement_second_level)</eqn>
				<units>first_level</units>
			</aux>
			<aux name="start\nyear first level" access="input">
				<eqn>2025</eqn>
				<format precision="1"/>
				<range min="2025" max="2100"/>
				<units>year</units>
			</aux>
			<aux name="time to implement first level" access="input">
				<eqn>10</eqn>
				<format precision="1"/>
				<range min="5" max="50"/>
				<units>Year</units>
			</aux>
			<aux name="first level" access="input">
				<eqn>100



{c$/(tCO2e/year)}</eqn>
				<format precision="1"/>
				<range min="0" max="300"/>
				<units>widget</units>
			</aux>
			<aux name="time to\nstart second level" access="input">
				<eqn>50</eqn>
				<format precision="1"/>
				<range min="5" max="100"/>
				<units>year</units>
			</aux>
			<aux name="time to implement second level" access="input">
				<eqn>10</eqn>
				<format precision="1"/>
				<range min="5" max="50"/>
				<units>Year</units>
			</aux>
			<aux name="second level" access="input">
				<eqn>50

{c$/(tCO2e/year)}</eqn>
				<format precision="1"/>
				<range min="0" max="300"/>
				<units>widget</units>
			</aux>
		</variables>
		<view isee:show_pages="false" background="white" page_width="768" page_height="576" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
			<style>
				<graph>
					<isee:series_styles>
						<isee:series_style color="blue" thickness="1"/>
						<isee:series_style color="red" thickness="1"/>
						<isee:series_style color="fuchsia" thickness="1"/>
						<isee:series_style color="#008F44" thickness="1"/>
						<isee:series_style color="#FF7F00" thickness="1"/>
						<isee:series_style color="#7F00FF" thickness="1"/>
						<isee:series_style color="#0CA0FF" thickness="1"/>
						<isee:series_style color="lime" thickness="1"/>
						<isee:series_style color="#FF007F" thickness="1"/>
						<isee:series_style color="aqua" thickness="1"/>
						<isee:series_style color="#F586FF" thickness="1"/>
						<isee:series_style color="black" thickness="1"/>
						<isee:series_style color="#C8C8C8" thickness="1"/>
					</isee:series_styles>
				</graph>
			</style>
			<aux x="485.651" y="284.67" name="Output"/>
			<aux font_weight="bold" x="298.833" y="212.5" name="start\nyear first level"/>
			<aux font_weight="bold" x="298.833" y="311.5" name="time to implement first level"/>
			<aux font_weight="bold" x="298.833" y="396.5" name="first level"/>
			<aux font_weight="bold" x="670.83" y="214.5" name="time to\nstart second level"/>
			<aux font_weight="bold" x="670.83" y="313.5" name="time to implement second level"/>
			<aux font_weight="bold" x="670.83" y="398.5" name="second level"/>
			<connector uid="1" angle="353.82">
				<from>start_year_first_level</from>
				<to>Output</to>
			</connector>
			<connector uid="2" angle="15.4463">
				<from>time_to_implement_first_level</from>
				<to>Output</to>
			</connector>
			<connector uid="3" angle="33.0707">
				<from>first_level</from>
				<to>Output</to>
			</connector>
			<connector uid="4" angle="191.004">
				<from>time_to_start_second_level</from>
				<to>Output</to>
			</connector>
			<connector uid="5" angle="169.719">
				<from>time_to_implement_second_level</from>
				<to>Output</to>
			</connector>
			<connector uid="6" angle="147.94">
				<from>second_level</from>
				<to>Output</to>
			</connector>
		</view>
	</macro>
	<macro name="THREEPARM">
		<eqn>Output</eqn>
		<parm>first level</parm>
		<parm>start year first level</parm>
		<parm>time to implement first level</parm>
		<variables>
			<aux name="Output" access="output">
				<doc>${Policy}
</doc>
				<eqn>RAMP(first_level/time_to_implement_first_level, start_year_first_level, start_year_first_level+time_to_implement_first_level)</eqn>
				<units>first_level</units>
			</aux>
			<aux name="start\nyear first level" access="input">
				<eqn>2025</eqn>
				<format precision="1" scale_by="auto"/>
				<range min="2025" max="2100"/>
				<units>year</units>
			</aux>
			<aux name="time to implement first level" access="input">
				<eqn>10</eqn>
				<format precision="1" scale_by="auto"/>
				<range min="5" max="50"/>
				<units>Year</units>
			</aux>
			<aux name="first level" access="input">
				<eqn>100</eqn>
				<format precision="1" scale_by="auto"/>
				<range min="0" max="300"/>
				<units>widget</units>
			</aux>
		</variables>
		<view isee:show_pages="false" background="white" page_width="768" page_height="576" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
			<style/>
			<aux x="485.651" y="284.67" name="Output"/>
			<aux font_weight="bold" x="298.833" y="212.5" name="start\nyear first level"/>
			<aux font_weight="bold" x="298.833" y="311.5" name="time to implement first level"/>
			<aux font_weight="bold" x="298.833" y="396.5" name="first level"/>
			<connector uid="1" angle="353.82">
				<from>start_year_first_level</from>
				<to>Output</to>
			</connector>
			<connector uid="2" angle="15.4463">
				<from>time_to_implement_first_level</from>
				<to>Output</to>
			</connector>
			<connector uid="3" angle="33.0707">
				<from>first_level</from>
				<to>Output</to>
			</connector>
		</view>
	</macro>
</xmile>

