			</aux>
			<aux name="concrete residential and service\nmaintenance policy" access="output">
				<doc>${Policy}
</doc>
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2100"/>
					<yscale min="0" max="1"/>
					<ypts>1,1,1,1,1,1,1,1,1</ypts>
				</gf>
				<units>dmnl</units>
			</aux>
			<aux name="concrete infrastructure maintenance policy" access="output">
