			<aux name="Max Share of GDP expended for Coal Extraction Subsidies" access="output" isee:autocreated="true">
				<doc>${Policy}
</doc>
				<eqn>0.01</eqn>
				<range min="0.00001" max="0.1"/>
				<units>dmnl</units>
			</aux>
			<aux name="Max Share of GDP expended for\nOil Extraction Subsidies" access="output">
				<doc>${Policy}
</doc>
