			<aux name="SWITCH Use Endogenous\nStorage Choice" access="output" isee:autocreated="true">
				<doc>${Policy}
</doc>
				<eqn>1</eqn>
				<format precision="1"/>
				<range min="0" max="1"/>
				<units>dmnl</units>
			</aux>
			<aux name="actual tax on CO2e emissions">
				<eqn>IF TIME &gt;= start_year THEN tax_on_CO2e_emissions ELSE 0</eqn>
				<units>c$/(tCO2e/year)</units>
			</aux>
			<aux name="use ILE mode">
				<eqn>0</eqn>
				<format precision="1"/>
				<scale min="0" max="0"/>
				<range min="0" max="1"/>
				<units>Dimensionless</units>
			</aux>
			<aux name="ILE tax on CO2e emissions">
				<eqn>SIXPARM(tax_on_CO2e_emissions_first_level, tax_on_CO2e_emissions_start_year_first_level, tax_on_CO2e_emissions_time_to_implement_first_level, tax_on_CO2e_emissions_second_level, tax_on_CO2e_emissions_time_to_start_second_level, tax_on_CO2e_emissions_time_to_implement_second_level)</eqn>
				<units>c$/(tCO2e/year)</units>
			</aux>
			<aux name="tax on\nCO2e emissions\nstart year first level">
				<doc>${Policy}
</doc>
				<eqn>2025</eqn>
				<format precision="1"/>
				<range min="2025" max="2100"/>
				<units>year</units>
			</aux>
			<aux name="tax on\nCO2e emissions\ntime to implement first level">
				<doc>${Policy}
</doc>
				<eqn>10</eqn>
				<format precision="1" suffix=" years"/>
				<range min="5" max="50"/>
				<units>Year</units>
			</aux>
			<aux name="tax on\nCO2e emissions\nfirst level">
				<doc>${Policy}
</doc>
				<eqn>0</eqn>
				<format precision="1" prefix="$ "/>
				<range min="0" max="300"/>
				<units>c$/(tCO2e/year)</units>
			</aux>
			<aux name="tax on\nCO2e emissions\ntime to start second level">
				<doc>${Policy}
</doc>
				<eqn>125</eqn>
				<format precision="1" suffix=" years"/>
				<range min="5" max="125"/>
				<units>year</units>
			</aux>
			<aux name="tax on\nCO2e emissions\ntime to implement second level">
				<doc>${Policy}
</doc>
				<eqn>10</eqn>
				<format precision="1" suffix=" years"/>
				<range min="5" max="50"/>
				<units>Year</units>
			</aux>
			<aux name="tax on\nCO2e emissions\nsecond level">
				<doc>${Policy}
</doc>
				<eqn>0</eqn>
				<format precision="1" prefix="$ "/>
				<range min="0" max="300"/>
				<units>c$/(tCO2e/year)</units>
			</aux>
			<aux name="GF tax on CO2e emissions">
				<doc>${Policy}
</doc>
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2100"/>
					<yscale min="0" max="1000"/>
					<ypts>0,0,0,0,0,0,0,0,0</ypts>
				</gf>
				<units>c$/(tCO2e/year)</units>
			</aux>
			<aux name="ILE tax rate on newly installed\ncoal extraction capacity">
				<eqn>SIXPARM(tax_rate_on_newly_installed_coal_extraction_capacity_first_level, tax_rate_on_newly_installed_coal_extraction_capacity_start_year_first_level, tax_rate_on_newly_installed_coal_extraction_capacity_time_to_implement_first_level, tax_rate_on_newly_installed_coal_extraction_capacity_second_level, tax_rate_on_newly_installed_coal_extraction_capacity_time_to_start_second_level, tax_rate_on_newly_installed_coal_extraction_capacity_time_to_implement_second_level)/100</eqn>
